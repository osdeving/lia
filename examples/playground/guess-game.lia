project GuessGame {
  repro best_effort;

  module game.main as adapter {
    usecase run() effects io {
      let secret = rand_int(1, 10);
      print("Guess the number (1-10)");
      loop {
        let raw = read_line("Your guess: ");
        if not is_int(raw) {
          print("Please type a number.");
          continue;
        }
        let guess = to_int(raw);
        if guess == secret {
          print("You win!");
          break;
        }
        if guess < secret {
          print("Too low.");
        } else {
          print("Too high.");
        }
      }
    }
  }
}
